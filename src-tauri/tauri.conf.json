{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "f1tv-hud-overlays",
  "version": "0.1.0",
  "identifier": "com.mantazzo.f1tvhudoverlays",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:3000/speedometer",
    "beforeDevCommand": "npm run start:test"
  },
  "app": {
    "windows": [
      {
        "title": "F1TV HUD Overlays",
        "width": 520,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
